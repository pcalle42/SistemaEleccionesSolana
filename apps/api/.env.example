# La configuración runtime canónica vive en infra/<entorno>/.env.example.
# Copie la plantilla correspondiente a infra/<entorno>/.env para sobrescribirla
# sin versionar secretos. La API reconoce local, test, devnet y production.
#
# Variables HTTP/logging/OpenAPI:
# VOTACIONES_ENV=local
# APP_HOST=127.0.0.1
# APP_PORT=3000
# HTTP_BODY_LIMIT_BYTES=262144
# HTTP_REQUEST_TIMEOUT_MS=15000
# HTTP_TRUST_PROXY_ADDRESSES=
# HTTP_CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# LOG_LEVEL=debug
# OPENAPI_ENABLED=true
# ADMIN_COOKIE_SECURE=false
# ADMIN_SESSION_IDLE_SECONDS=900
# ADMIN_SESSION_ABSOLUTE_SECONDS=28800
# ADMIN_LOGIN_WINDOW_SECONDS=300
# ADMIN_LOGIN_USER_MAXIMUM=5
# ADMIN_LOGIN_NETWORK_MAXIMUM=20
# VOTE_RATE_LIMIT_WINDOW_SECONDS=60
# VOTE_RATE_LIMIT_MAXIMUM=30
# VOTE_MAXIMUM_CONCURRENT_PROOFS=2
# ADMIN_ARGON2_MEMORY_KIB=19456
# ADMIN_ARGON2_TIME_COST=2
# ADMIN_ARGON2_PARALLELISM=1
#
# PostgreSQL y Valkey están documentados en sus plantillas de infra. No coloque
# credenciales reales en este archivo.
