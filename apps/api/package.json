{
  "name": "@votaciones/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:health": "tsx src/database/cli.ts health",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:migrate:test": "tsx src/database/cli.ts migrate --target test",
    "db:seed": "tsx src/database/cli.ts seed",
    "db:status": "tsx src/database/cli.ts status",
    "pretest": "pnpm build",
    "start": "node dist/main.js",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "pnpm db:migrate:test && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run src --exclude '**/*.integration.spec.ts'",
    "typecheck": "tsc --noEmit",
    "valkey:health": "tsx src/valkey/cli.ts health"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@votaciones/shared-types": "workspace:*",
    "@votaciones/shared-validation": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.3",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@votaciones/config-typescript": "workspace:*",
    "@votaciones/shared-testing": "workspace:*",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
