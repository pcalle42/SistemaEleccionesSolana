# LOCAL DEVELOPMENT ONLY. Never reuse these credentials in production.
VOTACIONES_ENV=local
APP_HOST=127.0.0.1
APP_PORT=3000
HTTP_BODY_LIMIT_BYTES=262144
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_CORS_ORIGINS=http://localhost:3001,http://localhost:3002
LOG_LEVEL=debug
OPENAPI_ENABLED=true
POSTGRES_DB=votaciones_local
POSTGRES_USER=votaciones_admin
POSTGRES_PASSWORD=local-admin-dev-only-password
POSTGRES_RUNTIME_USER=votaciones_runtime
POSTGRES_RUNTIME_PASSWORD=local-runtime-dev-only-password
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_CONNECT_TIMEOUT_MS=1000
VALKEY_COMMAND_TIMEOUT_MS=1000
VALKEY_MAX_RECONNECT_ATTEMPTS=3
DATABASE_MIGRATION_URL=postgresql://votaciones_admin:local-admin-dev-only-password@127.0.0.1:5432/votaciones_local
DATABASE_URL=postgresql://votaciones_runtime:local-runtime-dev-only-password@127.0.0.1:5432/votaciones_local
TEST_DATABASE_MIGRATION_URL=postgresql://votaciones_admin:local-admin-dev-only-password@127.0.0.1:5432/votaciones_local_test
TEST_DATABASE_URL=postgresql://votaciones_runtime:local-runtime-dev-only-password@127.0.0.1:5432/votaciones_local_test
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=5000
