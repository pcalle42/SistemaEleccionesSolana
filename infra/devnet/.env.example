# DEVNET INTEGRATION ONLY. Never reuse these credentials in production.
VOTACIONES_ENV=devnet
POSTGRES_DB=votaciones_devnet
POSTGRES_USER=votaciones_admin
POSTGRES_PASSWORD=devnet-admin-dev-only-password
POSTGRES_RUNTIME_USER=votaciones_runtime
POSTGRES_RUNTIME_PASSWORD=devnet-runtime-dev-only-password
POSTGRES_HOST_PORT=55432
DATABASE_MIGRATION_URL=postgresql://votaciones_admin:devnet-admin-dev-only-password@127.0.0.1:55432/votaciones_devnet
DATABASE_URL=postgresql://votaciones_runtime:devnet-runtime-dev-only-password@127.0.0.1:55432/votaciones_devnet
TEST_DATABASE_MIGRATION_URL=postgresql://votaciones_admin:devnet-admin-dev-only-password@127.0.0.1:55432/votaciones_devnet_test
TEST_DATABASE_URL=postgresql://votaciones_runtime:devnet-runtime-dev-only-password@127.0.0.1:55432/votaciones_devnet_test
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=5000
