# TEST ONLY. The guard rejects non-loopback hosts and database names without a _test suffix.
VOTACIONES_ENV=test
COMPOSE_PROJECT_NAME=votaciones-test-default
POSTGRES_DB=votaciones_test
POSTGRES_USER=votaciones_admin
POSTGRES_PASSWORD=test-admin-public-fixture
POSTGRES_RUNTIME_USER=votaciones_runtime
POSTGRES_RUNTIME_PASSWORD=test-runtime-public-fixture
POSTGRES_HOST_PORT=55432
VALKEY_HOST_PORT=56379
VALKEY_HOST=127.0.0.1
VALKEY_PORT=56379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_DB=0
DATABASE_MIGRATION_URL=postgresql://votaciones_admin:test-admin-public-fixture@127.0.0.1:55432/votaciones_test
DATABASE_URL=postgresql://votaciones_runtime:test-runtime-public-fixture@127.0.0.1:55432/votaciones_test
TEST_DATABASE_MIGRATION_URL=postgresql://votaciones_admin:test-admin-public-fixture@127.0.0.1:55432/votaciones_test
TEST_DATABASE_URL=postgresql://votaciones_runtime:test-runtime-public-fixture@127.0.0.1:55432/votaciones_test
VALKEY_CONNECT_TIMEOUT_MS=1000
VALKEY_COMMAND_TIMEOUT_MS=1000
VALKEY_MAX_RECONNECT_ATTEMPTS=1
VALKEY_ALLOW_DESTRUCTIVE_TESTS=true
