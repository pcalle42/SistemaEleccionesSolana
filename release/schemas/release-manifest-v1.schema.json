{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://votaciones.invalid/schemas/release-manifest-v1.schema.json",
  "title": "ReleaseManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "classification",
    "gitCommit",
    "buildTimestamp",
    "sourceRepository",
    "toolchain",
    "lockfileDigest",
    "images",
    "migrations",
    "protocols",
    "testEvidenceRefs",
    "securityScanRefs",
    "sbomRefs",
    "provenance",
    "compatibilityMatrixDigest",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "ReleaseManifestV1" },
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "classification": { "enum": ["devnet", "production"] },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "buildTimestamp": { "type": "string", "format": "date-time" },
    "sourceRepository": { "type": "string", "format": "uri" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "pnpmVersion"],
      "properties": {
        "nodeVersion": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "pnpmVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "lockfileDigest": { "$ref": "#/$defs/digest" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "adminWeb", "voterWeb"],
      "properties": {
        "api": { "$ref": "#/$defs/image" },
        "adminWeb": { "$ref": "#/$defs/image" },
        "voterWeb": { "$ref": "#/$defs/image" }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "latest", "setDigest"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "latest": { "type": "string", "pattern": "^[0-9]{4}_[a-z0-9_-]+\\.sql$" },
        "setDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "circuitId",
          "circuitVersion",
          "classification",
          "productionSafe",
          "artifactManifestDigest",
          "verificationKeyDigest",
          "artifactDigests"
        ],
        "properties": {
          "protocolVersion": { "type": "string", "minLength": 1 },
          "circuitId": { "type": "string", "minLength": 1 },
          "circuitVersion": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["devnet", "production"] },
          "productionSafe": { "type": "boolean" },
          "artifactManifestDigest": { "$ref": "#/$defs/digest" },
          "verificationKeyDigest": { "$ref": "#/$defs/digest" },
          "artifactDigests": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "testEvidenceRefs": { "$ref": "#/$defs/references" },
    "securityScanRefs": { "$ref": "#/$defs/references" },
    "sbomRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "adminWeb", "voterWeb"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "adminWeb": { "type": "string", "minLength": 1 },
        "voterWeb": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "workflowRef"],
      "properties": {
        "builder": { "type": "string", "minLength": 1 },
        "workflowRef": { "type": "string", "minLength": 1 }
      }
    },
    "compatibilityMatrixDigest": { "$ref": "#/$defs/digest" },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "reference"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "reference": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
