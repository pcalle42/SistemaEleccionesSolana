{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "electionId",
    "configurationVersion",
    "snapshotVersion",
    "merkleRoot",
    "protocolVersion",
    "circuitVersion",
    "manifestDigest",
    "artifactDigests",
    "releaseManifestDigest",
    "opensAt",
    "closesAt",
    "readinessChecks",
    "decision",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ElectionReadinessRecordV1"
    },
    "electionId": {
      "type": "string",
      "minLength": 1
    },
    "configurationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "snapshotVersion": {
      "type": "integer",
      "minimum": 1
    },
    "merkleRoot": {
      "type": "string",
      "minLength": 1
    },
    "protocolVersion": {
      "type": "string",
      "minLength": 1
    },
    "circuitVersion": {
      "type": "string",
      "minLength": 1
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "releaseManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "opensAt": {
      "type": "string",
      "format": "date-time"
    },
    "closesAt": {
      "type": "string",
      "format": "date-time"
    },
    "readinessChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "status", "evidenceRefs"],
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "NOT_TESTED", "NOT_APPLICABLE", "RISK_ACCEPTED"]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "decision": {
      "enum": ["GO", "NO-GO", "INCOMPLETE"]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
