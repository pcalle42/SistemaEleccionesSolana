{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "risks"],
  "properties": {
    "schemaVersion": {
      "const": "RiskRegisterV1"
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "property",
          "severity",
          "likelihood",
          "mitigation",
          "evidence",
          "owner",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "likelihood": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
