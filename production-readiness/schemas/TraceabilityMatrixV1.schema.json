{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "requirements"],
  "properties": {
    "schemaVersion": {
      "const": "TraceabilityMatrixV1"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "sourceDocument",
          "requirement",
          "criticality",
          "implementationRefs",
          "testRefs",
          "evidenceRefs",
          "status",
          "owner",
          "notes"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^(DOM|ELG|ZK|VOTE|AUD|RES|UI|SEC|OPS|INF)-[0-9]{3}$"
          },
          "sourceDocument": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "criticality": {
            "enum": ["critical", "high", "medium"]
          },
          "implementationRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "testRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": ["PASS", "FAIL", "NOT_TESTED", "NOT_APPLICABLE", "RISK_ACCEPTED"]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
