{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseManifestDigest",
    "environment",
    "synthetic",
    "startedAt",
    "finishedAt",
    "artifactDigests",
    "metrics",
    "scenarios",
    "findings",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ElectionRehearsalReportV1"
    },
    "releaseManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "status", "evidenceRefs"],
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "NOT_TESTED", "NOT_APPLICABLE", "RISK_ACCEPTED"]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": ["PASS", "FAIL", "INCOMPLETE"]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
