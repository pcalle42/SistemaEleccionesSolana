{
  "schemaVersion": "RuntimeSecretsContractV1",
  "delivery": "runtime-secret-injection",
  "forbiddenLocations": ["git", "container-image", "frontend-bundle", "logs", "release-evidence"],
  "secrets": [
    { "name": "DATABASE_URL", "consumer": "api-runtime", "scope": "database-dml" },
    { "name": "DATABASE_MIGRATION_URL", "consumer": "migration-job", "scope": "database-ddl" },
    { "name": "VALKEY_URL", "consumer": "api-runtime", "scope": "auxiliary-cache" },
    {
      "name": "METRICS_AUTH_TOKEN",
      "consumer": "observability-collector",
      "scope": "metrics-read"
    },
    {
      "name": "ARTIFACT_STORE_CREDENTIAL",
      "consumer": "publication-job",
      "scope": "immutable-artifact-write"
    },
    { "name": "BACKUP_CREDENTIAL", "consumer": "backup-restore-job", "scope": "isolated-backup" }
  ]
}
