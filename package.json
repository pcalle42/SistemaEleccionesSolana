{
  "name": "sistema-elecciones-solana",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para el sistema Votaciones.",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ],
    "overrides": {
      "underscore@<=1.13.7": "1.13.8",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  },
  "scripts": {
    "admin:create": "pnpm --filter @votaciones/api admin:create",
    "admin:reset-password": "pnpm --filter @votaciones/api admin:reset-password",
    "admin:revoke-sessions": "pnpm --filter @votaciones/api admin:revoke-sessions",
    "api:dev": "pnpm --filter @votaciones/api dev",
    "api:start": "pnpm --filter @votaciones/api start",
    "build": "pnpm --recursive --if-present build",
    "artifacts:backup": "bash infra/scripts/backup-artifacts.sh",
    "artifacts:restore": "bash infra/scripts/restore-artifacts.sh",
    "ci:critical": "bash scripts/ci/critical.sh",
    "ci:main": "bash scripts/ci/main.sh",
    "ci:release": "bash scripts/ci/release.sh",
    "ci:validate": "bash scripts/ci/validate.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "node scripts/clean.mjs",
    "db:backup": "bash infra/scripts/db-backup.sh devnet",
    "db:generate": "pnpm --filter @votaciones/api db:generate",
    "db:health": "pnpm --filter @votaciones/api db:health",
    "db:migrate": "pnpm --filter @votaciones/api db:migrate",
    "db:reset": "bash infra/scripts/db-reset.sh local",
    "db:restore": "bash infra/scripts/db-restore.sh devnet",
    "db:restore:drill": "bash infra/scripts/restore-drill.sh",
    "db:seed": "pnpm --filter @votaciones/api db:seed",
    "db:status": "pnpm --filter @votaciones/api db:status",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "bash infra/scripts/config.sh local",
    "infra:down": "bash infra/scripts/down.sh local",
    "infra:logs": "bash infra/scripts/logs.sh local",
    "infra:reset": "bash infra/scripts/reset.sh local",
    "infra:smoke": "bash infra/scripts/smoke.sh local",
    "infra:status": "bash infra/scripts/status.sh local",
    "infra:up": "bash infra/scripts/up.sh local",
    "infra:verify:persistence": "bash infra/scripts/verify-persistence.sh local",
    "lint": "eslint .",
    "ops:clock-check": "node scripts/operations/check-clock-drift.mjs",
    "production:profile:verify": "node scripts/production/verify-profile.mjs",
    "release:manifest": "node scripts/release/generate-manifest.mjs",
    "release:migrations:verify": "node scripts/release/verify-migrations.mjs",
    "release:post-deploy": "node scripts/release/post-deploy.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:promotion-record": "node scripts/release/generate-promotion-record.mjs",
    "release:provenance": "node scripts/release/generate-provenance.mjs",
    "release:verify": "node scripts/release/verify-manifest.mjs",
    "release:zk:verify": "node scripts/release/verify-zk-registry.mjs",
    "test": "pnpm build && pnpm --recursive --if-present test",
    "test:all": "pnpm test:release",
    "test:browser": "pnpm build && playwright test",
    "test:browser:devnet": "playwright test --config playwright.devnet.config.ts",
    "test:concurrency": "bash tests/scripts/run-with-infra.sh concurrency",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "pnpm test:e2e:api && pnpm test:browser",
    "test:e2e:api": "pnpm build && pnpm --filter @votaciones/api test:e2e",
    "test:infra:config": "bash infra/scripts/test-infra.sh config",
    "test:infra:down": "bash infra/scripts/test-infra.sh down",
    "test:infra:reset": "bash infra/scripts/test-infra.sh reset",
    "test:infra:up": "bash infra/scripts/test-infra.sh up",
    "test:integration": "bash tests/scripts/run-with-infra.sh integration",
    "test:main": "pnpm test:unit && pnpm test:contract && pnpm test:property && pnpm test:zk && pnpm test:integration && pnpm test:concurrency && pnpm test:valkey && pnpm test:security && pnpm test:verification",
    "test:operations": "vitest run tests/operations",
    "test:performance": "pnpm build && node tests/scripts/performance-baseline.mjs",
    "test:production": "vitest run tests/production",
    "test:pr": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contract && pnpm test:production && pnpm build",
    "test:property": "vitest run tests/property",
    "test:release": "pnpm test:main && pnpm test:reproducibility && pnpm test:performance",
    "test:reproducibility": "bash tests/scripts/reproducibility.sh",
    "test:release-contract": "vitest run tests/release",
    "test:security": "pnpm test:security:policy && pnpm test:contract && pnpm test:e2e:api && pnpm test:browser",
    "test:security:policy": "vitest run tests/security apps/api/src/common/logging/logging.module.spec.ts apps/api/src/config/app-config.spec.ts",
    "test:unit": "pnpm build && pnpm --recursive --if-present test:unit",
    "test:valkey": "bash tests/scripts/run-with-infra.sh valkey",
    "test:verification": "bash tests/scripts/run-with-infra.sh verification",
    "test:zk": "pnpm --filter @votaciones/zk-protocol test",
    "typecheck": "pnpm build && pnpm --recursive --if-present typecheck",
    "verify:election": "pnpm --filter @votaciones/verification-protocol build && node packages/verification-protocol/dist/src/cli.js",
    "valkey:health": "pnpm --filter @votaciones/api valkey:health",
    "valkey:verify:loss": "bash infra/scripts/verify-valkey-loss.sh local",
    "zk:compile": "pnpm --filter @votaciones/zk-protocol zk:compile",
    "zk:benchmark": "pnpm --filter @votaciones/zk-protocol zk:benchmark",
    "zk:inspect": "pnpm --filter @votaciones/zk-protocol zk:inspect",
    "zk:setup": "pnpm --filter @votaciones/zk-protocol zk:setup",
    "zk:test": "pnpm --filter @votaciones/zk-protocol zk:test",
    "zk:verify-artifacts": "pnpm --filter @votaciones/zk-protocol zk:verify-artifacts",
    "devnet:config": "bash infra/scripts/config.sh devnet",
    "devnet:bootstrap": "bash infra/scripts/devnet-bootstrap.sh",
    "devnet:down": "bash infra/scripts/down.sh devnet",
    "devnet:logs": "bash infra/scripts/logs.sh devnet",
    "devnet:e2e": "bash infra/scripts/devnet-e2e.sh",
    "devnet:reset": "bash infra/scripts/reset.sh devnet",
    "devnet:smoke": "bash infra/scripts/smoke.sh devnet",
    "devnet:status": "bash infra/scripts/status.sh devnet",
    "devnet:up": "bash infra/scripts/up.sh devnet",
    "devnet:verify": "bash infra/scripts/devnet-verify.sh devnet",
    "devnet:verify:persistence": "bash infra/scripts/verify-persistence.sh devnet"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.1",
    "@votaciones/config-eslint": "workspace:*",
    "@votaciones/config-typescript": "workspace:*",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
