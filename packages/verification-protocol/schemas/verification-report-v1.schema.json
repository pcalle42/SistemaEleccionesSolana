{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://votaciones.example/schemas/verification-report-v1.schema.json",
  "title": "VerificationReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verificationReportVersion",
    "packageVersion",
    "packageDigest",
    "packageContentDigest",
    "valid",
    "manifestValid",
    "artifactsValid",
    "voteSetDigestValid",
    "proofsValid",
    "nullifiersUnique",
    "tallyValid",
    "resultValid",
    "checkpointsValid",
    "errors"
  ],
  "properties": {
    "verificationReportVersion": { "const": "verification-report-v1" },
    "packageVersion": { "type": "string" },
    "packageDigest": { "type": "string" },
    "packageContentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "valid": { "type": "boolean" },
    "manifestValid": { "type": "boolean" },
    "artifactsValid": { "type": "boolean" },
    "voteSetDigestValid": { "type": "boolean" },
    "proofsValid": { "type": "boolean" },
    "nullifiersUnique": { "type": "boolean" },
    "tallyValid": { "type": "boolean" },
    "resultValid": { "type": "boolean" },
    "checkpointsValid": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
