{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://votaciones.example/schemas/vote-receipt-v1.schema.json",
  "title": "VoteReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "electionId", "nullifier", "receiptCommitment", "acceptedAt"],
  "properties": {
    "receiptVersion": { "const": "anonymous-vote-receipt-v1" },
    "electionId": { "type": "string", "format": "uuid" },
    "nullifier": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,79})$" },
    "receiptCommitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acceptedAt": { "type": "string", "format": "date-time" }
  }
}
