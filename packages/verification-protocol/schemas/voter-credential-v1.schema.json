{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://votaciones.example/schemas/voter-credential-v1.schema.json",
  "title": "VoterCredentialV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "protocolVersion",
    "electionId",
    "voterSecret",
    "identityCommitment"
  ],
  "properties": {
    "formatVersion": { "const": "voter-credential-v1" },
    "protocolVersion": { "const": "anonymous-single-choice-v1" },
    "electionId": { "type": "string", "format": "uuid" },
    "voterSecret": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,79})$" },
    "identityCommitment": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,79})$" }
  }
}
